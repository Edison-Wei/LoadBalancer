set(LB_SANITIZER "none" CACHE STRING "Instrumentation: none, address-undefined, or thread")
set_property(CACHE LB_SANITIZER PROPERTY STRINGS none address-undefined thread)

add_library(lb_sanitizers INTERFACE)
if(LB_SANITIZER STREQUAL "none")
  return()
endif()
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  message(FATAL_ERROR "Sanitizer presets require GCC or Clang")
endif()
if(LB_SANITIZER STREQUAL "address-undefined")
  set(lb_sanitizer_flags -fsanitize=address,undefined -fno-omit-frame-pointer)
elseif(LB_SANITIZER STREQUAL "thread")
  set(lb_sanitizer_flags -fsanitize=thread -fno-omit-frame-pointer)
else()
  message(FATAL_ERROR "Unknown LB_SANITIZER='${LB_SANITIZER}'")
endif()
target_compile_options(lb_sanitizers INTERFACE ${lb_sanitizer_flags})
target_link_options(lb_sanitizers INTERFACE ${lb_sanitizer_flags})
